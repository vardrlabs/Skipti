# Rust
/target/
core/target/
server/target/
**/*.rs.bk

# Node / web
node_modules/
web/dist/
web/.vite/
*.tsbuildinfo

# Xcode / iOS
ios/DerivedData/
# The Xcode project itself is committed source (D-44); only per-user
# state stays out.
xcuserdata/
ios/DerivedData/
ios/build/
*.xcuserstate
.DS_Store

# Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
# Native slices are regenerated by `make android-core`, ignored locally by
# android/.gitignore with the same rationale as ios/Frameworks below:
# large build outputs stay out of history; the COMMITTED Kotlin bindings
# remain the source of truth the gate checks.
*.jks
*.keystore
keystore.properties

# Secrets and local config
.env
.env.*
!.env.example
# D-254: the Functions emulator's params (an emulator-only admin uid, never uploaded).
!firebase/functions/.env.local

# Editor
.idea/
.vscode/
*.swp

# Runtime SQLite vaults (relay + skrin test artifacts)
*.db
*.db-wal
*.db-shm

# iOS build artifacts: regenerated by `make ios-core` (scripts/build-ios-core.sh).
# 468 MB of staticlibs and xcframework slices; two exceed GitHub's 100 MB limit.
ios/Frameworks/

# Claude Code local settings: machine-specific, not for the open-source repo.
.claude/settings.local.json

# Xcode 26 auto-creates a workspace alongside the hand-written pbxproj;
# its contents are IDE state, not project definition.
ios/Skipti.xcodeproj/project.xcworkspace/

# Gate failure artifacts (preserved failing-leg output, D-93)
scripts/gate-artifacts/

# Android Studio's generated daemon-JVM criteria (JDK download URLs); the
# project builds only with Studio's JBR via JAVA_HOME, and
# gradle.properties forbids JDK downloads (D-140)
android/gradle/gradle-daemon-jvm.properties

# kotlinc standalone-binding-check cache (fetched jna jar + class output)
android/.kotlinc-cache/

# transient device-resolution handoff lives under ios/build/logs/ (already ignored)
# generated SBOMs (gate leg; uploaded as CI artifacts)
*.cdx.json

# Firebase app configs (skipti-26): google-services.json carries the signing SHA-1s, kept out of the public repo.
# Fetch: firebase/node_modules/.bin/firebase apps:sdkconfig IOS|ANDROID <app id> --project skipti-26 -o <path> (ids in WORKLOG).
ios/Skipti/GoogleService-Info.plist
android/app/google-services.json

# Firebase emulator logs (scripts/firebase-rules-test.sh)
firebase/*-debug.log
# Firebase Hosting's deploy cache (file hashes of the last upload; D-199)
firebase/.firebase/

# D-216: the app icon's Affinity working documents stay local (brand/skipti-icon-assets/ holds the exports).
brand/skipti-icon-affinity/

# The never-public records live in vardrlabs/skipti-private, checked out at ./private/ (decision 124; CLAUDE.md
# section 3); the two docs/ paths are symlinks into it.
/private/
/docs/CLOUD-SECURITY.md
/docs/SECURITY-ADVISORIES.md
