# ADR-0030 layer 1: daily at 04:17 UTC (a quiet hour for the relay).
# Persistent=true means a powered-off box catches up at boot instead of
# silently skipping the day.
[Unit]
Description=Daily SKIPTI relay vault backup

[Timer]
OnCalendar=*-*-* 04:17:00 UTC
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
